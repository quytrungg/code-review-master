# Local-first configuration. Copy to .env and adjust as needed.

# Any SQLAlchemy URL. PostgreSQL is the default; SQLite still works for tests and
# for a throwaway local database:
#   DATABASE_URL=sqlite:///./app.db
DATABASE_URL=postgresql+psycopg://localhost:5432/code_review

# Encrypts provider tokens at rest (version_control_keys.token, llm_keys.api_key).
# Generate one with: cd backend && python scripts/generate_encryption_key.py
# Never commit the real key, and back it up separately from the database: without it the
# stored credentials cannot be decrypted. Comma-separated to rotate: "<new>,<old>".
# CREDENTIALS_ENCRYPTION_KEY=

# Vercel/serverless mode: no startup migrations or orphan sweep, NullPool + no prepared
# statements, read-only skill files, no local Ollama models. Leave false for local and Docker.
# SERVERLESS=false

# Set false after the first account on a public deployment; sign-up then returns 403.
# SIGNUP_ENABLED=true

# Directory holding the local review skill files (.md / .txt). Defaults to the
# repository-level ./code-review folder when unset.
# SKILLS_DIR=../code-review

# Uploaded Core Skill Foundations (one folder each).
# FOUNDATIONS_DIR=../code-review-foundations
SKILL_FILE_MAX_BYTES=2000000
FOUNDATION_MAX_FILES=500
FOUNDATION_MAX_CHARS=20000000

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_TIMEOUT_S=10
LLM_TIMEOUT_S=180
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_S=30
# Hosted Ollama endpoint used when settings.ollama_mode = cloud.
OLLAMA_CLOUD_URL=https://ollama.com

# Prompt budgets (characters). The skill library is much larger than a prompt, so it is
# sampled by relevance to the changed files.
SKILLS_MAX_CHARS=80000
DIFF_MAX_CHARS=60000
LLM_MAX_TOKENS=4096
